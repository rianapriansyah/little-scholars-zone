VITE_SUPABASE_URL=https://vocivoavwohhfhbdgkia.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Domain used to auto-generate parent login emails on family registration
# (firstname + first 3 letters of second name, e.g. Rian Apriansyah -> rianapr@lsz.id).
VITE_FAMILY_EMAIL_DOMAIN=lsz.id

# This project targets the Supabase project aliased as `supabase-lsz-app` in MCP config
# (project_ref=vocivoavwohhfhbdgkia). On Vercel, set all VITE_* in Project → Settings →
# Environment Variables (they are baked in at build time; redeploy after changes).

# Temporary: first Auth user becomes admin (see migration auth_first_user_admin). Remove after onboarding.
# VITE_SHOW_ADMIN_BOOTSTRAP=true

# Dev-only role switcher in the app bar: signs straight in as a seeded test account so
# checking a change across admin/guru/orang tua takes one tap.
#
# LOCAL ONLY — NEVER SET THESE IN VERCEL. Vite inlines VITE_* into the JS bundle at build
# time, so these passwords would be readable by anyone who views source in a deployed build.
# Use throwaway test accounts, not real ones. Without VITE_DEV_ROLE_SWITCHER=true the
# switcher renders nothing, so leaving all of this unset is the safe default.
#
# A role with only some of its variables set is skipped, so you can configure just the ones
# you need. Put the real values in .env (gitignored) — never here, this file is committed.
# VITE_DEV_ROLE_SWITCHER=true
# VITE_DEV_ADMIN_EMAIL=admin@example.test
# VITE_DEV_ADMIN_PASSWORD=
# VITE_DEV_TEACHER_EMAIL=teacher@example.test
# VITE_DEV_TEACHER_PASSWORD=
# VITE_DEV_PARENT_EMAIL=parent@example.test
# VITE_DEV_PARENT_PASSWORD=

